# SPDX-License-Identifier: GPL-2.0
#
# StormBreaker -- configuration fragment applied on top of AOSP's gki_defconfig.
#
# Every line here is a deliberate choice. gki_defconfig itself is never edited,
# so any default upstream adds or changes keeps applying across an LTS rebase.
# This file IS the complete and honest list of what StormBreaker changes
# relative to AOSP.
#
# Usage with plain make:
#   make O=out ARCH=arm64 LLVM=1 gki_defconfig
#   scripts/kconfig/merge_config.sh -m -O out out/.config \
#       arch/arm64/configs/stormbreaker.fragment
#   make O=out ARCH=arm64 LLVM=1 olddefconfig
#
# Base: android15-6.6 @ 6.6.142

#
# Identity
#
# AOSP's "-4k" marks the page size; the 16k variant is a separate build.
# Keeping the marker is what stops a 4k and a 16k build from looking alike in
# uname.
CONFIG_LOCALVERSION="-StormBreaker-4k"
# Turns off the automatic suffix ("+" / git describe) without having to patch
# scripts/setlocalversion.
# CONFIG_LOCALVERSION_AUTO is not set

#
# Loading the vendor modules
#
# Without this a rebuilt GKI rejects the stock signed modules, which is the
# device's entire driver set. A requirement, not an optimisation.
# CONFIG_MODULE_SIG_PROTECT is not set

#
# Build
#
# ThinLTO: a real gain in both performance and size, and what Google ships in
# production. Needs HAS_LTO_CLANG (a suitable clang) and
# ARCH_SUPPORTS_LTO_CLANG_THIN.
# CONFIG_LTO_NONE is not set
CONFIG_LTO_CLANG_THIN=y

#
# Power
#
# NOTHING HERE, on purpose. The rodin bootloader already passes
# "rcu_nocbs=all" and "rcutree.enable_rcu_lazy" on the vendor_boot cmdline, so
# CONFIG_RCU_NOCB_CPU_DEFAULT_ALL and RCU_LAZY_DEFAULT_OFF=n would be no-ops on
# this hardware. Setting them would only make this fragment claim something it
# does not deliver.
#

#
# CPU scheduler: BORE
#
# Burst-Oriented Response Enhancer 5.9.6 by Masahito Suzuki (firelzrd), ported
# to the frozen android15-8 KMI. Per-entity state is parked in the
# ANDROID_KABI_USE slots of struct sched_entity, which keeps the symbol CRCs
# intact. Runtime kill switch: /proc/sys/kernel/sched_bore
CONFIG_SCHED_BORE=y
CONFIG_MIN_BASE_SLICE_NS=2000000

#
# I/O scheduler: ADIOS
#
# Adaptive Deadline I/O Scheduler 3.3.0 by Masahito Suzuki (firelzrd),
# backported from 6.12 to 6.6. Has to be =y: it uses private block layer
# headers and symbols that are not on the KMI symbol list.
CONFIG_MQ_IOSCHED_ADIOS=y
# What the kernel picks when a queue is created.
CONFIG_MQ_IOSCHED_DEFAULT_ADIOS=y
# ... which the vendor overrides: init.mt6899.rc writes "mq-deadline" on the
# sys.boot_completed=1 trigger, the last one of the boot. Without root the user
# cannot undo it either -- SELinux denies the shell domain even a directory
# search on sysfs_devices_block -- so the kernel re-asserts once, after
# userspace has settled, and says so in dmesg. Justified by measurement on the
# device: random 4K reads with three background writers gave +19.8% IOPS and
# -25.4% at p99.9 against mq-deadline. With no write pressure the two tie,
# which is the coherent result: ADIOS arbitrates reads against writes, and with
# no writes there is nothing to arbitrate.
CONFIG_STORMBREAKER_IOSCHED_REASSERT=y

#
# Network
#
# BBRv3, by Google, ported from github.com/google/bbr (branch
# bbr-v3-2026-09-16-01) to this tree. BBRv3 is NOT in mainline nor in
# net-next -- v1 is all upstream has -- so this is an out-of-tree port, with
# the divergences documented at the top of net/ipv4/tcp_bbr3.c.
#
# BBRv1 stays compiled (gki_defconfig:162 has CONFIG_TCP_CONG_BBR=y) so the
# two can be selected at runtime on one kernel:
#   sysctl net.ipv4.tcp_congestion_control=bbr    (or bbr3)
CONFIG_TCP_CONG_BBR3=y
CONFIG_DEFAULT_BBR3=y
CONFIG_DEFAULT_TCP_CONG="bbr3"

# Queueing discipline default. Nothing in this ROM sets one, so every
# interface falls back to pfifo_fast.
#
# NET_SCH_FQ_CODEL=y alone does not move the default. net/sched/Kconfig gates
# the whole "Default queuing discipline" choice behind NET_SCH_DEFAULT, which
# AOSP leaves off, so DEFAULT_NET_SCH falls through to "pfifo_fast".
#
# For the wlan path this is the only queue we have: CONFIG_CFG80211 is not set
# in this kernel, so there is no mac80211 underneath with its own internal
# fq_codel. BBR does not need fq to pace here -- it uses TCP internal pacing.
CONFIG_NET_SCH_DEFAULT=y
CONFIG_DEFAULT_FQ_CODEL=y

#
# Filesystem
#
# xattr on tmpfs: a prerequisite for several root/SELinux flows and for
# overlayfs on top of tmpfs.
CONFIG_TMPFS_XATTR=y
