#!/usr/bin/env python3
"""magiskboot stand-in that models the one behaviour under test.

Documented contract: repack compresses the supplied kernel with the format of
the original image, UNLESS the supplied file is already in a compressed format,
in which case it is embedded as-is. That is exactly why handing it a pre
compressed Image.lz4 pins lz4 onto a device that boots gzip.

Only the kernel region is modelled; the repacked image is header + kernel +
ramdisk with no trailing padding, which is the harder case for the AVB code.
"""
import gzip, struct, subprocess, sys, pathlib

MAGICS = {
    b'\x02\x21\x4c\x18': 'lz4_legacy',
    b'\x04\x22\x4d\x18': 'lz4',
    b'\x1f\x8b':         'gzip',
    b'\xfd7zXZ':         'xz',
    b'\x28\xb5\x2f\xfd': 'zstd',
    b'BZh':              'bzip2',
}

def fmt_of(b):
    for magic, name in MAGICS.items():
        if b.startswith(magic):
            return name
    return 'raw'

def layout(d):
    if d[:8] != b'ANDROID!':
        sys.exit("stub: not an Android boot image")
    hv = struct.unpack_from('<I', d, 40)[0]
    ksz = struct.unpack_from('<I', d, 8)[0]
    if hv in (3, 4):
        page, rsz = 4096, struct.unpack_from('<I', d, 12)[0]
    else:
        page, rsz = struct.unpack_from('<I', d, 36)[0], struct.unpack_from('<I', d, 16)[0]
    return hv, page, ksz, rsz

def pad(n, page):
    return (n + page - 1) // page * page

def compress(data, fmt):
    if fmt == 'gzip':
        return gzip.compress(data, 9, mtime=0)
    if fmt in ('lz4_legacy', 'lz4'):
        args = ['lz4', '-9', '-f'] + (['-l'] if fmt == 'lz4_legacy' else []) + ['-c']
        return subprocess.run(args, input=data, stdout=subprocess.PIPE,
                              stderr=subprocess.DEVNULL, check=True).stdout
    return data

cmd = sys.argv[1]
if cmd == 'unpack':
    d = pathlib.Path(sys.argv[2]).read_bytes()
    hv, page, ksz, rsz = layout(d)
    kern = d[page:page + ksz]
    fmt = fmt_of(kern[:8])
    pathlib.Path('kernel').write_bytes(kern)
    print(f"KERNEL_FMT [{fmt}]")
    pathlib.Path('.stub_fmt').write_text(fmt)
elif cmd == 'repack':
    src = pathlib.Path(sys.argv[2]).read_bytes()
    out = sys.argv[3]
    hv, page, ksz, rsz = layout(src)
    orig_fmt = pathlib.Path('.stub_fmt').read_text().strip()
    kern = pathlib.Path('kernel').read_bytes()
    if fmt_of(kern[:8]) == 'raw' and orig_fmt != 'raw':
        kern = compress(kern, orig_fmt)
    hdr = bytearray(src[:page])
    struct.pack_into('<I', hdr, 8, len(kern))
    ram = src[page + pad(ksz, page): page + pad(ksz, page) + rsz]
    img = bytes(hdr) + kern + b'\0' * (pad(len(kern), page) - len(kern))
    if rsz:
        img += ram + b'\0' * (pad(rsz, page) - rsz)
    pathlib.Path(out).write_bytes(img)
sys.exit(0)
